"use client";

import {
  ChangeEvent,
  useCallback,
  useEffect,
  useRef,
  useState,
} from "react";

type VisionSource = "offline" | "live" | "test-image";

type BoundingBox = {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
};

type Detection = {
  label: string;
  class_id: number;
  confidence: number;
  bbox: BoundingBox;
};

type DetectionResponse = {
  status: string;
  model: string;
  image: {
    width: number;
    height: number;
  };
  count: number;
  detections: Detection[];
};

type VisionStatus = {
  status: string;
  model: string;
  camera_connected: boolean;
  object_detection: string;
};

type CameraStatus = {
  service: string;
  camera_connected: boolean;
  stream_available: boolean;
  source: string;
  frames_received: number;
  frame_age_seconds: number | null;
  error: string | null;
};

const API_BASE =
  process.env.NEXT_PUBLIC_API_URL ||
  "http://127.0.0.1:8000";

const CAMERA_BASE =
  process.env.NEXT_PUBLIC_G1_CAMERA_URL ||
  (typeof window !== "undefined"
    ? `${window.location.protocol}//${window.location.hostname}:8770`
    : "http://127.0.0.1:8770");

export default function VisionPage() {
  const [source, setSource] =
    useState<VisionSource>("offline");

  const [imageUrl, setImageUrl] =
    useState<string | null>(null);

  const [selectedFile, setSelectedFile] =
    useState<File | null>(null);

  const [detections, setDetections] =
    useState<Detection[]>([]);

  const [imageDimensions, setImageDimensions] =
    useState<{ width: number; height: number } | null>(null);

  const [visionStatus, setVisionStatus] =
    useState<VisionStatus | null>(null);

  const [cameraStatus, setCameraStatus] =
    useState<CameraStatus | null>(null);

  const [detecting, setDetecting] = useState(false);
  const [connecting, setConnecting] = useState(false);

  const [modelName, setModelName] =
    useState("Not loaded");

  const [streamKey, setStreamKey] = useState(0);
  const [streamError, setStreamError] = useState(false);

  const [message, setMessage] = useState(
    "Checking the physical G1 camera connection..."
  );

  const fileInputRef = useRef<HTMLInputElement>(null);
  const streamImageRef = useRef<HTMLImageElement>(null);

  const refreshCameraStatus = useCallback(async () => {
    try {
      const response = await fetch(
        `${CAMERA_BASE}/status`,
        {
          cache: "no-store",
          signal: AbortSignal.timeout(3000),
        }
      );

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      const data: CameraStatus = await response.json();
      setCameraStatus(data);
      return data;
    } catch {
      setCameraStatus(null);
      return null;
    }
  }, []);

  useEffect(() => {
    let active = true;

    async function loadVisionStatus() {
      try {
        const response = await fetch(
          `${API_BASE}/api/vision/status`,
          { cache: "no-store" }
        );

        if (!response.ok) {
          throw new Error(
            `Vision API returned HTTP ${response.status}`
          );
        }

        const data: VisionStatus = await response.json();

        if (active) {
          setVisionStatus(data);
          setModelName(data.model);
        }
      } catch {
        if (active) {
          setVisionStatus(null);
        }
      }
    }

    loadVisionStatus();

    return () => {
      active = false;
    };
  }, []);

  useEffect(() => {
    refreshCameraStatus();

    const interval = setInterval(
      refreshCameraStatus,
      3000
    );

    return () => clearInterval(interval);
  }, [refreshCameraStatus]);

  async function connectCamera() {
    setConnecting(true);
    setMessage("Connecting to the G1 head camera...");

    try {
      const status = await refreshCameraStatus();

      if (!status?.camera_connected) {
        throw new Error(
          status?.error ||
            "Camera bridge is not receiving frames."
        );
      }

      setSource("live");
      setImageUrl(null);
      setSelectedFile(null);
      setDetections([]);
      setImageDimensions(null);
      setStreamError(false);
      setStreamKey((value) => value + 1);

      setMessage(
        "G1 camera connected. Live video is starting."
      );
    } catch (error) {
      setMessage(
        error instanceof Error
          ? `Camera connection failed: ${error.message}`
          : "Camera connection failed."
      );
    } finally {
      setConnecting(false);
    }
  }

  function disconnectCamera() {
    setSource("offline");
    setStreamError(false);
    setDetections([]);
    setImageDimensions(null);
    setMessage(
      "Live preview disconnected. The camera bridge remains running."
    );
  }

  function refreshStream() {
    setStreamError(false);
    setStreamKey((value) => value + 1);
    setMessage("Refreshing live camera stream...");
  }

  function handleImageUpload(
    event: ChangeEvent<HTMLInputElement>
  ) {
    const file = event.target.files?.[0];

    if (!file) return;

    if (
      !["image/jpeg", "image/png", "image/webp"].includes(
        file.type
      )
    ) {
      setMessage(
        "Please select a JPEG, PNG or WebP image."
      );
      return;
    }

    if (file.size > 10 * 1024 * 1024) {
      setMessage(
        "The image must be smaller than 10 MB."
      );
      return;
    }

    const reader = new FileReader();

    reader.onload = () => {
      setImageUrl(String(reader.result));
      setSelectedFile(file);
      setSource("test-image");
      setDetections([]);
      setImageDimensions(null);

      setMessage(
        "Test image loaded. Click Detect Objects to run YOLO."
      );
    };

    reader.onerror = () => {
      setMessage("Failed to load the image.");
    };

    reader.readAsDataURL(file);
    event.target.value = "";
  }

  async function getDetectionFile(): Promise<File> {
    if (source === "test-image" && selectedFile) {
      return selectedFile;
    }

    if (source === "live") {
      const response = await fetch(
        `${CAMERA_BASE}/snapshot`,
        {
          cache: "no-store",
          signal: AbortSignal.timeout(5000),
        }
      );

      if (!response.ok) {
        throw new Error(
          `Camera snapshot failed: HTTP ${response.status}`
        );
      }

      const blob = await response.blob();

      if (!blob.type.startsWith("image/jpeg")) {
        throw new Error(
          "Camera returned an invalid image format."
        );
      }

      return new File(
        [blob],
        `g1-camera-${Date.now()}.jpg`,
        { type: "image/jpeg" }
      );
    }

    throw new Error("No image source selected.");
  }

  async function detectObjects() {
    if (source === "offline" || detecting) return;

    setDetecting(true);
    setDetections([]);
    setMessage("Running YOLO object detection...");

    try {
      const file = await getDetectionFile();

      const formData = new FormData();
      formData.append("file", file);

      const response = await fetch(
        `${API_BASE}/api/vision/detect`,
        {
          method: "POST",
          body: formData,
        }
      );

      if (!response.ok) {
        let detail = `HTTP ${response.status}`;

        try {
          const errorData = await response.json();
          if (typeof errorData.detail === "string") {
            detail = errorData.detail;
          }
        } catch {
          // Preserve HTTP error.
        }

        throw new Error(detail);
      }

      const data: DetectionResponse =
        await response.json();

      setDetections(data.detections);
      setImageDimensions(data.image);
      setModelName(data.model);

      setMessage(
        `Detection completed: ${data.count} object(s) found.`
      );
    } catch (error) {
      setMessage(
        error instanceof Error
          ? `Detection failed: ${error.message}`
          : "Detection failed."
      );
    } finally {
      setDetecting(false);
    }
  }

  async function captureSnapshot() {
    try {
      let url = imageUrl;
      let filename = `g1-vision-${Date.now()}.png`;

      if (source === "live") {
        const response = await fetch(
          `${CAMERA_BASE}/snapshot`,
          {
            cache: "no-store",
            signal: AbortSignal.timeout(5000),
          }
        );

        if (!response.ok) {
          throw new Error(
            `Snapshot failed: HTTP ${response.status}`
          );
        }

        const blob = await response.blob();
        url = URL.createObjectURL(blob);
        filename = `g1-camera-${Date.now()}.jpg`;
      }

      if (!url) {
        throw new Error("No image is available.");
      }

      const link = document.createElement("a");
      link.href = url;
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      link.remove();

      if (source === "live") {
        const temporaryUrl = url;
        setTimeout(
          () => URL.revokeObjectURL(temporaryUrl),
          1000
        );
      }

      setMessage("Snapshot downloaded.");
    } catch (error) {
      setMessage(
        error instanceof Error
          ? error.message
          : "Snapshot failed."
      );
    }
  }

  function clearPreview() {
    setImageUrl(null);
    setSelectedFile(null);
    setSource("offline");
    setDetections([]);
    setImageDimensions(null);
    setStreamError(false);
    setMessage("Preview cleared.");
  }

  const cameraConnected =
    cameraStatus?.camera_connected === true;

  const liveActive = source === "live";

  const canDetect =
    !detecting &&
    (source === "test-image" ||
      (liveActive && cameraConnected && !streamError));

  return (
    <div className="min-h-screen bg-slate-50 p-6 text-slate-900">
      <div className="mx-auto max-w-7xl space-y-6">
        <header>
          <h1 className="text-3xl font-semibold">
            G1 Vision
          </h1>

          <p className="mt-1 text-sm text-slate-500">
            IPSE · Visual Perception &amp; Object Recognition
          </p>
        </header>

        <div className="grid gap-6 lg:grid-cols-3">
          <section className="space-y-4 lg:col-span-2">
            <div className="overflow-hidden rounded-2xl border bg-white shadow-sm">
              <div className="flex items-center justify-between border-b p-4">
                <h2 className="font-semibold">
                  G1 Head Camera
                </h2>

                <span
                  className={`rounded-full px-3 py-1 text-xs font-medium ${
                    liveActive && cameraConnected && !streamError
                      ? "bg-green-100 text-green-800"
                      : source === "test-image"
                        ? "bg-blue-100 text-blue-800"
                        : "bg-amber-100 text-amber-800"
                  }`}
                >
                  {liveActive
                    ? cameraConnected && !streamError
                      ? "Live Camera"
                      : "Camera Unavailable"
                    : source === "test-image"
                      ? "Test Image"
                      : cameraConnected
                        ? "Camera Ready"
                        : "Camera Offline"}
                </span>
              </div>

              <div className="relative flex aspect-video items-center justify-center overflow-hidden bg-slate-950">
                {liveActive ? (
                  <>
                    <img
                      key={streamKey}
                      ref={streamImageRef}
                      src={`${CAMERA_BASE}/stream?session=${streamKey}`}
                      alt="Live Unitree G1 head camera"
                      className="h-full w-full object-contain"
                      onLoad={() => {
                        setStreamError(false);
                        setMessage(
                          "G1 live camera preview active."
                        );
                      }}
                      onError={() => {
                        setStreamError(true);
                        setMessage(
                          "Camera stream interrupted. Click Refresh Stream."
                        );
                      }}
                    />

                    {imageDimensions && detections.length > 0 && (
                      <DetectionOverlay
                        detections={detections}
                        dimensions={imageDimensions}
                      />
                    )}

                    <span className="absolute left-4 top-4 rounded-md bg-red-600 px-3 py-1 text-xs font-semibold text-white">
                      ● LIVE
                    </span>

                    {streamError && (
                      <div className="absolute inset-0 flex items-center justify-center bg-slate-950/90 p-6 text-center text-white">
                        Camera stream unavailable. Click Refresh Stream.
                      </div>
                    )}
                  </>
                ) : imageUrl ? (
                  <div className="relative h-full w-full">
                    <img
                      src={imageUrl}
                      alt="G1 Vision preview"
                      className="h-full w-full object-contain"
                    />

                    {imageDimensions && (
                      <DetectionOverlay
                        detections={detections}
                        dimensions={imageDimensions}
                      />
                    )}
                  </div>
                ) : (
                  <div className="text-center text-slate-400">
                    <div className="text-5xl">📷</div>

                    <p className="mt-4 font-medium">
                      {cameraConnected
                        ? "G1 Camera Ready"
                        : "G1 Camera Not Connected"}
                    </p>

                    <p className="mt-2 text-sm">
                      {cameraConnected
                        ? "Click Connect Camera to start live video."
                        : "Start the G1 camera bridge on port 8770."}
                    </p>
                  </div>
                )}
              </div>

              <div className="flex flex-wrap gap-3 p-4">
                {!liveActive ? (
                  <button
                    type="button"
                    onClick={connectCamera}
                    disabled={!cameraConnected || connecting}
                    className="rounded-lg bg-green-700 px-4 py-2 text-sm font-medium text-white hover:bg-green-800 disabled:opacity-40"
                  >
                    {connecting
                      ? "Connecting..."
                      : "Connect Camera"}
                  </button>
                ) : (
                  <>
                    <button
                      type="button"
                      onClick={disconnectCamera}
                      className="rounded-lg bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-800"
                    >
                      Disconnect
                    </button>

                    <button
                      type="button"
                      onClick={refreshStream}
                      className="rounded-lg border px-4 py-2 text-sm font-medium hover:bg-slate-50"
                    >
                      Refresh Stream
                    </button>
                  </>
                )}

                <button
                  type="button"
                  onClick={() =>
                    fileInputRef.current?.click()
                  }
                  disabled={detecting}
                  className="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-800 disabled:opacity-40"
                >
                  Load Test Image
                </button>

                <button
                  type="button"
                  onClick={detectObjects}
                  disabled={!canDetect}
                  className="rounded-lg bg-blue-700 px-4 py-2 text-sm font-medium text-white hover:bg-blue-800 disabled:opacity-40"
                >
                  {detecting
                    ? "Detecting..."
                    : "Detect Objects"}
                </button>

                <button
                  type="button"
                  onClick={captureSnapshot}
                  disabled={source === "offline"}
                  className="rounded-lg border px-4 py-2 text-sm font-medium disabled:opacity-40"
                >
                  Save Snapshot
                </button>

                <button
                  type="button"
                  onClick={clearPreview}
                  disabled={detecting}
                  className="rounded-lg border px-4 py-2 text-sm font-medium disabled:opacity-40"
                >
                  Clear
                </button>

                <input
                  ref={fileInputRef}
                  type="file"
                  accept="image/jpeg,image/png,image/webp"
                  onChange={handleImageUpload}
                  className="hidden"
                />
              </div>
            </div>

            <div className="rounded-xl border bg-white p-4 text-sm text-slate-600">
              {message}
            </div>
          </section>

          <aside className="space-y-6">
            <section className="rounded-2xl border bg-white p-5 shadow-sm">
              <h2 className="font-semibold">
                Vision Status
              </h2>

              <div className="mt-5 space-y-4 text-sm">
                <StatusRow
                  label="Camera Bridge"
                  value={
                    cameraConnected
                      ? "Connected"
                      : "Unavailable"
                  }
                />

                <StatusRow
                  label="Camera Preview"
                  value={
                    liveActive
                      ? streamError
                        ? "Stream Error"
                        : "Live"
                      : source === "test-image"
                        ? "Test Mode"
                        : "Disconnected"
                  }
                />

                <StatusRow
                  label="Camera Resolution"
                  value="1920 × 1080"
                />

                <StatusRow
                  label="Frames Received"
                  value={String(
                    cameraStatus?.frames_received ?? 0
                  )}
                />

                <StatusRow
                  label="Vision API"
                  value={
                    visionStatus
                      ? "Connected"
                      : "Unavailable"
                  }
                />

                <StatusRow
                  label="Detection Model"
                  value={modelName}
                />

                <StatusRow
                  label="Detected Objects"
                  value={String(detections.length)}
                />

                <StatusRow
                  label="Physical Walking"
                  value="Locked"
                />
              </div>
            </section>

            <section className="rounded-2xl border bg-white p-5 shadow-sm">
              <h2 className="font-semibold">
                Object Detection
              </h2>

              <p className="mt-2 text-sm text-slate-500">
                YOLO results from a test image or a captured
                live camera frame.
              </p>

              {detections.length === 0 ? (
                <div className="mt-5 rounded-xl bg-slate-50 p-5 text-center text-sm text-slate-500">
                  {detecting
                    ? "Analyzing image..."
                    : "No detections available"}
                </div>
              ) : (
                <div className="mt-4 max-h-80 space-y-3 overflow-y-auto">
                  {detections.map((item, index) => (
                    <div
                      key={`${item.label}-${index}`}
                      className="rounded-lg border p-3"
                    >
                      <div className="flex items-center justify-between gap-3">
                        <span className="font-medium capitalize">
                          {item.label}
                        </span>

                        <span className="text-sm font-semibold text-emerald-700">
                          {Math.round(
                            item.confidence * 100
                          )}
                          %
                        </span>
                      </div>

                      <div className="mt-2 h-2 overflow-hidden rounded-full bg-slate-100">
                        <div
                          className="h-full rounded-full bg-emerald-600"
                          style={{
                            width: `${
                              item.confidence * 100
                            }%`,
                          }}
                        />
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </section>

            <section className="rounded-2xl border bg-white p-5 shadow-sm">
              <h2 className="font-semibold">
                Thesis Use Cases
              </h2>

              <div className="mt-4 space-y-3 text-sm text-slate-600">
                <p>👤 Visitor detection and welcoming</p>
                <p>☕ Coffee machine recognition</p>
                <p>🖨️ 3D printer identification</p>
                <p>📦 Object and component detection</p>
                <p>🤖 Visual perception for demonstrations</p>
              </div>

              <p className="mt-4 text-xs text-slate-400">
                Specialized lab-object recognition requires
                model validation or custom training.
              </p>
            </section>
          </aside>
        </div>
      </div>
    </div>
  );
}

function DetectionOverlay({
  detections,
  dimensions,
}: {
  detections: Detection[];
  dimensions: {
    width: number;
    height: number;
  };
}) {
  return (
    <svg
      className="pointer-events-none absolute inset-0 h-full w-full"
      viewBox={`0 0 ${dimensions.width} ${dimensions.height}`}
      preserveAspectRatio="xMidYMid meet"
    >
      {detections.map((item, index) => {
        const { x1, y1, x2, y2 } = item.bbox;

        return (
          <g key={`${item.label}-${index}`}>
            <rect
              x={x1}
              y={y1}
              width={Math.max(0, x2 - x1)}
              height={Math.max(0, y2 - y1)}
              fill="none"
              stroke="#22c55e"
              strokeWidth="3"
            />

            <text
              x={x1}
              y={Math.max(18, y1 - 8)}
              fill="#22c55e"
              fontSize="20"
              fontWeight="bold"
            >
              {item.label}{" "}
              {Math.round(item.confidence * 100)}%
            </text>
          </g>
        );
      })}
    </svg>
  );
}

function StatusRow({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <div className="flex items-center justify-between gap-4">
      <span className="text-slate-500">{label}</span>
      <span className="font-medium">{value}</span>
    </div>
  );
}
