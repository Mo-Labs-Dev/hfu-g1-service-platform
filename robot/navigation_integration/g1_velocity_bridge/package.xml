<?xml version="1.0"?>
<package format="3">
  <name>g1_velocity_bridge</name><version>0.1.0</version>
  <description>Bounded ROS navigation velocity bridge to the G1 Loco SDK.</description>
  <maintainer email="unitree@example.com">unitree</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>nlohmann_json</build_depend>
  <depend>rclcpp</depend><depend>geometry_msgs</depend><depend>nav_msgs</depend>
  <depend>std_msgs</depend><depend>std_srvs</depend>
  <depend>tf2_ros</depend><depend>tf2_geometry_msgs</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rmw_fastrtps_cpp</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
